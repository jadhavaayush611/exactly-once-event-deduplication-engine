# Redis-compatible URL. For local Docker Compose, use redis://redis:6379/0
ENGINE_REDIS_URL=redis://localhost:6379/0

# Free Render topology: one service instance, partition-aware local processing.
ENGINE_ENABLE_PARTITIONS=1
ENGINE_NUM_PARTITIONS=4
ENGINE_INSTANCE_ID=local-single
ENGINE_INTERNAL_ENDPOINT=

# Memory sink is appropriate only for a disposable demo.
ENGINE_SINK=memory
ENGINE_SINK_PATH=./data/events.jsonl
